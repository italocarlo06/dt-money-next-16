# Copie para .env e preencha com os dados do projeto Supabase:
# Dashboard > Project Settings > Database

# URI recomendada para a API Nest (conexão direta ao Postgres, porta 5432).
# Em "Connection string" escolha URI e substitua [YOUR-PASSWORD].
# Deve incluir ?sslmode=require (o painel do Supabase costuma já colocar).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.ffbsowkbkfebtvqrnrrl.supabase.co:5432/postgres?sslmode=require"

# Porta HTTP da API (o app Next usa NEXT_PUBLIC_API_URL apontando para aqui)
PORT=3333
